# Atara-Pay Gateway configuration
ATARA_PAY_PORT=8080
ATARA_PAY_DEFAULT_RAIL=crossmint
ATARA_PAY_ROUTING_MODE=smart

# --- Persistence ---
# Both are optional during MVP. Required once M2/M3 land.
# Local quickstart:
#   docker run -d --name atara-pg -e POSTGRES_PASSWORD=atara -p 5432:5432 postgres:16
#   docker run -d --name atara-redis -p 6379:6379 redis:7
DATABASE_URL=postgres://postgres:atara@localhost:5432/atara_pay?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# HS256 secret for dashboard session JWTs. Must be >= 32 bytes.
# Generate one locally:  openssl rand -base64 48
SESSION_SIGNING_KEY=

# Master keys for the encrypted keystore (Level 2). Each VN must decode to
# exactly 32 bytes. Add a new VN to rotate without downtime; old ciphertexts
# stay readable until they're re-encrypted to the new version.
# Generate a key:  openssl rand -base64 32
ATARA_PAY_MASTER_KEY_V1=
# Optional. Defaults to the highest VN present.
# ATARA_PAY_KEYSTORE_CURRENT_VERSION=1

# --- CrossMint ---
# Get a key at https://www.crossmint.com/console
CROSSMINT_API_KEY=
# Use https://staging.crossmint.com for staging.
CROSSMINT_BASE_URL=https://www.crossmint.com

# --- Tempo ---
# Public testnet:  https://rpc.moderato.tempo.xyz   (chainId 42431)
# Public mainnet:  https://rpc.presto.tempo.xyz     (chainId 4217)
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
TEMPO_CHAIN_ID=42431
