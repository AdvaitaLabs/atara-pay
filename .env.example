# Atara-Pay local deploy env. Copy to `.env`, fill in the REQUIRED
# secrets, then `./scripts/deploy-local.sh`. The deploy script refuses
# to bring the gateway up without SESSION_SIGNING_KEY +
# ATARA_PAY_MASTER_KEY_V1.

# ─── Environment label ────────────────────────────────────────────────
# Stamped onto /health and the x-atara-environment header. Production
# deploys must set this to "production"; anything else triggers the
# sandbox banner at startup.
ATARA_PAY_ENVIRONMENT=staging

# Default rail when the client doesn't pin one. Either rail must be
# configured below; mismatching this with available rails refuses to boot.
ATARA_PAY_DEFAULT_RAIL=tempo
ATARA_PAY_ROUTING_MODE=smart
ATARA_PAY_PORT=8080

# ─── Persistence ─────────────────────────────────────────────────────
# These DSNs are what docker-compose injects when running inside the
# compose network. For host-side runs against the same containers,
# substitute localhost:5432 / localhost:6379.
DATABASE_URL=postgres://atara:atara@postgres:5432/atara_pay?sslmode=disable
REDIS_URL=redis://redis:6379/0

# ─── Session signing (Dashboard JWTs) ────────────────────────────────
# REQUIRED. >= 32 bytes. Generate with:
#   openssl rand -base64 48
SESSION_SIGNING_KEY=

# ─── Keystore master key (encrypts Tempo + session-key private keys) ─
# REQUIRED. 32 raw bytes, base64-encoded. Generate with:
#   openssl rand -base64 32
# Rotate by adding ATARA_PAY_MASTER_KEY_V2=... and bumping
# ATARA_PAY_KEYSTORE_CURRENT_VERSION=2 — older versions stay loaded so
# legacy ciphertext keeps decrypting.
ATARA_PAY_MASTER_KEY_V1=
# ATARA_PAY_KEYSTORE_CURRENT_VERSION=1

# ─── Tempo rail ──────────────────────────────────────────────────────
# Public testnet:  https://rpc.moderato.tempo.xyz   (chainId 42431)
# Public mainnet:  https://rpc.presto.tempo.xyz     (chainId 4217)
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
TEMPO_CHAIN_ID=42431

# ─── CrossMint rail (OPTIONAL) ───────────────────────────────────────
# When unset, the gateway boots without the CrossMint adapter:
# platform-custody groups skip the CrossMint half, onramp returns 503,
# self-custody Tempo flows are unaffected. Set both for full feature
# parity. Get a key at https://www.crossmint.com/console — pick staging.
CROSSMINT_API_KEY=
CROSSMINT_BASE_URL=https://staging.crossmint.com

# ─── Image tag (cosmetic) ────────────────────────────────────────────
# Stamps Version into the binary (atara --version, /health). Defaults to
# "dev"; CI / release pipelines should set the SemVer tag.
ATARA_VERSION=dev
